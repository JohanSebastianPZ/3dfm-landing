---
interface Props {
  title?: string
  description?: string
}
const {
  title = 'PrintLab3D — Impresión 3D profesional',
  description = 'Impresión 3D para empresas y makers. FDM, SLA, SLS. Entrega en 48h.',
} = Astro.props
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />

    <meta property="og:image" content="https://printlab3d.com/images/hero-poster.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://printlab3d.com/images/hero-poster.jpg" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="PrintLab3D" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "@id": "https://printlab3d.com/#business",
        "name": "PrintLab3D",
        "description": "Impresión 3D profesional",
        "url": "https://printlab3d.com",
        "image": "https://printlab3d.com/images/hero-poster.jpg",
        "email": "hola@printlab3d.com",
        "telephone": "+34930000000",
        "openingHours": "Mo-Fr 09:00-18:00",
        "priceRange": "€€",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "ES"
        }
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
