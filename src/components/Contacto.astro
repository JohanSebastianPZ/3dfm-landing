---
import ContactoForm from './ContactoForm.tsx'
---
<section id="contacto" class="py-24 px-6 sm:px-12 md:px-20 lg:px-28" style="background: var(--bg-page)">
  <div class="section-container">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

      <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
        <span
          class="inline-flex items-center rounded-full px-3 py-1 text-[14px] font-medium border mb-6"
          style="color: #FF5500; border-color: rgba(255,85,0,0.25)"
        >
          Contacto
        </span>
        <h2
          class="text-[2rem] sm:text-[2.75rem] font-medium tracking-tight mb-4"
          style="color: var(--color-900)"
        >
          ¿Tienes un proyecto en mente?
        </h2>
        <p class="text-[17px] mb-10 leading-relaxed" style="color: var(--color-400)">
          Cuéntanos qué necesitas y te enviamos un presupuesto personalizado en menos de 24h.
        </p>

        <div class="flex flex-col gap-5 w-full">
          <div class="flex items-center justify-center lg:justify-start gap-3">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF5500" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <span class="text-[16px]" style="color: var(--color-500)">info@3dfactorymaker.com</span>
          </div>
          <div class="flex items-center justify-center lg:justify-start gap-3">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF5500" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.24 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.15 1.1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16z"/>
            </svg>
            <span class="text-[16px]" style="color: var(--color-500)">+57 350 620 53 26</span>
          </div>
          <div class="flex items-center justify-center lg:justify-start gap-3">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF5500" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            <span class="text-[16px]" style="color: var(--color-500)">Lun – Vie, 9:00 – 18:00</span>
          </div>
        </div>
      </div>

      <div class="w-full">
        <ContactoForm client:visible />
      </div>

    </div>

  </div>
</section>

<script async src="https://js.hcaptcha.com/1/api.js"></script>