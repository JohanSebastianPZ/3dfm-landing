---
---

<header class="nav-header" id="nav-header">
  <nav class="nav" aria-label="Navegación principal">

    <!-- Logo izquierda -->
    <a href="/" class="nav-logo" aria-label="3DFM — Ir al inicio">
      <div class="nav-logo-icon" aria-hidden="true">
        <img 
          src="/images/logo-navbar.webp" 
          alt="Logo de PrintLab3D" 
          class="w-8 h-8 object-contain"
          width="32"
          height="32"
        />
      </div>
      <span class="nav-logo-name">3D<span class="nav-logo-accent">FM</span></span>
    </a>

    <!-- Pill única derecha: links + separador + CTA -->
    <div class="nav-pill">

      <div class="nav-links">
        <a href="#servicios" class="nav-link">SERVICIOS</a>
        <a href="#galeria"   class="nav-link">PROYECTOS</a>
        <a href="#precios"   class="nav-link">PRECIOS</a>
        <a href="#contacto"  class="nav-link">CONTACTO</a>
      </div>

      <div class="nav-sep" aria-hidden="true"></div>

      <a href="#contacto" class="nav-cta" aria-label="Solicitar presupuesto">
        PRESUPUESTO
        <div class="nav-cta-arrow" aria-hidden="true">→</div>
      </a>

    </div>

    <!-- Botón hamburger mobile -->
    <button
      class="nav-burger"
      id="nav-burger"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="nav-mobile"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

  </nav>

  <!-- Menú mobile -->
  <div class="nav-mobile" id="nav-mobile" aria-hidden="true">
    <a href="#servicios" class="nav-mobile-link">SERVICIOS</a>
    <a href="#galeria"   class="nav-mobile-link">PROYECTOS</a>
    <a href="#precios"   class="nav-mobile-link">PRECIOS</a>
    <a href="#contacto"  class="nav-mobile-link">CONTACTO</a>
    <a href="#contacto"  class="nav-mobile-cta">PRESUPUESTO →</a>
  </div>

</header>

<style>
  /* ─── Header wrapper ─── */
  .nav-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 18px 42px;
    transition: background 0.3s ease, backdrop-filter 0.3s ease;
  }

  .nav-header.scrolled {
    background: rgba(20, 20, 18, 0.72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.06);
  }

  /* ─── Nav row ─── */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: 1700px;
    margin: 0 auto;
  }

  /* ─── Logo ─── */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-logo-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.08);
    border: 0.5px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background 0.2s ease;
  }

  .nav-logo:hover .nav-logo-icon {
    background: rgba(255, 255, 255, 0.12);
  }

  .nav-logo-name {
    font-size: 25px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .nav-logo-accent {
    color: #FF5500;
  }

  /* ─── Pill única ─── */
  .nav-pill {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.08);
    border: 0.5px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    padding: 6px 6px 6px 22px;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    gap: 0;
  }

  /* ─── Links ─── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav-link {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.07em;
    color: rgb(255, 255, 255);
    padding: 8px 16px;
    border-radius: 999px;
    text-decoration: none;
    transition: color 0.2s ease, background 0.2s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.07);
  }

  /* ─── Separador vertical ─── */
  .nav-sep {
    width: 0.5px;
    height: 16px;
    background: rgba(255, 255, 255, 0.15);
    margin: 0 10px;
    flex-shrink: 0;
  }

  /* ─── CTA ─── */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #111111;
    background: #ffffff;
    border-radius: 999px;
    padding: 9px 16px 9px 20px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .nav-cta:hover {
    background: #FF5500;
    color: #ffffff;
  }

  .nav-cta:hover .nav-cta-arrow {
    background: #ffffff;
    color: #FF5500;
  }

  .nav-cta-arrow {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #FF5500;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    color: #ffffff;
    flex-shrink: 0;
    transition: background 0.2s ease, color 0.2s ease;
  }

  /* ─── Burger mobile ─── */
  .nav-burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }

  .nav-burger span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .nav-burger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .nav-burger.open span:nth-child(2) { opacity: 0; }
  .nav-burger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* ─── Menú mobile ─── */
  .nav-mobile {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 12px 0 8px;
    max-width: 1280px;
    margin: 0 auto;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.3s ease, padding 0.3s ease;
  }

  .nav-mobile.open {
    max-height: 400px;
    padding: 12px 0 16px;
  }

  .nav-mobile-link {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    padding: 10px 4px;
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.06);
    transition: color 0.2s;
  }

  .nav-mobile-link:hover { color: #ffffff; }

  .nav-mobile-cta {
    display: inline-flex;
    align-items: center;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.07em;
    color: #FF5500;
    text-decoration: none;
    padding: 12px 4px 4px;
    transition: color 0.2s;
  }

  .nav-mobile-cta:hover { color: #E04D00; }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .nav-pill   { display: none; }
    .nav-burger { display: flex; }
    .nav-mobile { display: flex; }
  }

  @media (max-width: 480px) {
    .nav-header { padding: 12px 16px; }
    .nav-logo-name { font-size: 15px; }
  }
</style>

<script>
  const header = document.getElementById('nav-header')
  const burger = document.getElementById('nav-burger')
  const mobile = document.getElementById('nav-mobile')

  window.addEventListener('scroll', () => {
    if (window.scrollY > 60) {
      header?.classList.add('scrolled')
    } else {
      header?.classList.remove('scrolled')
    }
  }, { passive: true })

  burger?.addEventListener('click', () => {
    const isOpen = burger.classList.toggle('open')
    mobile?.classList.toggle('open', isOpen)
    burger.setAttribute('aria-expanded', String(isOpen))
    mobile?.setAttribute('aria-hidden', String(!isOpen))
    burger.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú')
  })

  mobile?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      burger?.classList.remove('open')
      mobile?.classList.remove('open')
      burger?.setAttribute('aria-expanded', 'false')
      mobile?.setAttribute('aria-hidden', 'true')
      burger?.setAttribute('aria-label', 'Abrir menú')
    })
  })
</script>
