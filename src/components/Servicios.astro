---
interface Servicio {
  id: string
  nombre: string
  descripcion: string
  materiales: string[]
  usoCases: string
  acento: string
  icono: string
}

const servicios: Servicio[] = [
  {
    id: 'fdm',
    nombre: 'FDM / FFF',
    descripcion: 'Fabricación por deposición fundida. La tecnología más versátil para prototipos y piezas funcionales a precio competitivo.',
    materiales: ['PLA', 'PETG', 'ABS', 'TPU', 'Nylon'],
    usoCases: 'Prototipos · Series cortas · Piezas funcionales',
    acento: '#FF5500',
    icono: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
  },
  {
    id: 'sla',
    nombre: 'Resina SLA / DLP',
    descripcion: 'Fotopolimerización de resina líquida. Resolución extrema para piezas con detalles muy finos y acabados lisos.',
    materiales: ['ABS-like', 'Flexible', 'Dental', 'Castable'],
    usoCases: 'Joyería · Figuras · Dental · Miniaturas',
    acento: '#7C3AED',
    icono: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>`,
  },
  {
    id: 'sls',
    nombre: 'Nylon SLS',
    descripcion: 'Sinterización selectiva por láser. Resistencia técnica sin necesidad de soportes. Ideal para industria y automoción.',
    materiales: ['PA12', 'PA11', 'TPU', 'PA-GF'],
    usoCases: 'Industria · Automoción · Aeroespacial',
    acento: '#D97706',
    icono: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><ellipse cx="12" cy="12" rx="11" ry="4.2"/><ellipse cx="12" cy="12" rx="11" ry="4.2" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="11" ry="4.2" transform="rotate(120 12 12)"/></svg>`,
  },
  {
    id: 'post',
    nombre: 'Posprocesado',
    descripcion: 'Acabados profesionales para que cada pieza luzca exactamente como la imaginas. Pintura, lijado, cromado y ensamblaje.',
    materiales: ['Lijado', 'Pintura', 'Cromado', 'Pulido'],
    usoCases: 'Presentaciones · Packaging · Exposición',
    acento: '#059669',
    icono: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>`,
  },
]

const svChevron = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>`
---

<section id="servicios" class="py-24 px-6 sm:px-12 md:px-20 lg:px-28"
         style="background: var(--bg-page)">
  <div class="section-container">

    <div class="sv-grid">

      <!-- Columna izquierda: badge + h2 + p + divider + lista -->
      <div class="sv-left">

        <div class="mb-10">
          <span
            class="inline-flex items-center rounded-full px-3 py-1 text-[14px] font-medium border mb-6"
            style="color: #FF5500; border-color: rgba(255,85,0,0.25)"
          >
            Servicios
          </span>
          <h2
            class="text-[2rem] sm:text-[2.75rem] font-medium tracking-tight mb-4 max-w-lg"
            style="color: var(--color-900)"
          >
            Tecnología al servicio de tu proyecto
          </h2>
          <p class="text-[17px]" style="color: var(--color-400)">
            Cada tecnología tiene su lugar. Te ayudamos a elegir la correcta.
          </p>
        </div>

        <div class="sv-divider" aria-hidden="true"></div>

        <div class="sv-list" id="sv-list">
          {servicios.map((s, i) => (
            <div
              class="sv-item"
              data-id={s.id}
              data-acento={s.acento}
              role="button"
              tabindex="0"
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-label={`Ver detalles de ${s.nombre}`}
            >
              <div class="sv-item-top">
                <div
                  class="sv-icon"
                  style={`background: ${s.acento}15; border: 0.5px solid ${s.acento}40; color: ${s.acento}`}
                  aria-hidden="true"
                  set:html={s.icono}
                />
                <span class="sv-item-name">{s.nombre}</span>
                <span class="sv-chevron" aria-hidden="true" set:html={svChevron} />
              </div>
              <div class="sv-item-body">
                <div class="sv-item-body-inner">
                  <p class="sv-item-desc">{s.descripcion}</p>
                  <div class="sv-pills">
                    {s.materiales.map(m => (
                      <span class="sv-pill">{m}</span>
                    ))}
                  </div>
                  <div class="sv-item-footer">{s.usoCases}</div>
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>

      <!-- Columna derecha: imagen con glow naranja -->
      <div class="sv-right" aria-hidden="true">
        <div class="sv-glow"></div>
        <img
          src="/images/services-image.png"
          alt="Rey de ajedrez negro siendo impreso en 3D por un extrusor FDM, mostrando las capas de filamento y la estructura interna de la pieza"
          class="sv-img"
          loading="lazy"
          width="514"
          height="1024"
        />
      </div>

    </div>
  </div>
</section>

<style>
  /* Grid principal — dos columnas simétricas */
  .sv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  /* Columna izquierda */
  .sv-left {
    display: flex;
    flex-direction: column;
  }

  /* Divider entre header y lista */
  .sv-divider {
    height: 0.5px;
    background: var(--color-border);
    margin-bottom: 1.5rem;
  }

  /* Lista */
  .sv-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sv-item {
    padding: 14px 16px;
    border-radius: 0 12px 12px 0;
    border: 0.5px solid var(--color-border);
    border-left: 3px solid transparent;
    background: var(--bg-surface);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
    outline: none;
  }

  .sv-item:focus-visible {
    box-shadow: 0 0 0 2px #FF5500;
  }

  .sv-item.active {
    background: var(--bg-page);
    border-color: var(--color-border);
  }

  .sv-item-top {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .sv-icon {
    width: 26px;
    height: 26px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sv-item-name {
    font-size: 17px;
    font-weight: 500;
    color: var(--color-900);
    flex: 1;
  }

  .sv-chevron {
    display: flex;
    align-items: center;
    color: var(--color-400);
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .sv-item.active .sv-chevron {
    transform: rotate(180deg);
  }

  /* Accordion grid trick */
  .sv-item-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
    overflow: hidden;
  }

  .sv-item.active .sv-item-body {
    grid-template-rows: 1fr;
  }

  .sv-item-body-inner {
    min-height: 0;
  }

  .sv-item-desc {
    font-size: 16px;
    color: var(--color-400);
    line-height: 1.65;
    margin-top: 10px;
    margin-bottom: 10px;
  }

  .sv-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 10px;
  }

  .sv-pill {
    font-size: 14px;
    padding: 3px 10px;
    border-radius: 20px;
    border: 0.5px solid var(--color-border);
    color: var(--color-500);
    background: var(--bg-surface);
  }

  .sv-item-footer {
    font-size: 14px;
    color: var(--color-300);
    padding-top: 10px;
    border-top: 0.5px solid var(--color-border);
  }

  /* ─── Columna derecha ─── */
  .sv-right {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 2.5rem 2rem;
  }

  /* Glow naranja radial detrás de la pieza */
  .sv-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 65% 70% at 50% 58%,
        rgba(255, 85,  0, 0.22) 0%,
        rgba(255, 120, 30, 0.10) 35%,
        rgba(255, 85,  0, 0.03) 60%,
        transparent 80%
      );
    pointer-events: none;
    z-index: 0;
  }

  /* Halo secundario difuso */
  .sv-glow::after {
    content: '';
    position: absolute;
    inset: 10% 15%;
    background: radial-gradient(
      ellipse 80% 60% at 50% 60%,
      rgba(255, 140, 40, 0.08) 0%,
      transparent 70%
    );
    filter: blur(24px);
  }

  /* Imagen */
  .sv-img {
    width: 100%;
    max-width: 380px;
    height: auto;
    display: block;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    filter:
      drop-shadow(0 0 28px rgba(255, 85, 0, 0.35))
      drop-shadow(0 0 55px rgba(255, 85, 0, 0.14))
      drop-shadow(0 24px 40px rgba(0, 0, 0, 0.20));
  }

  /* Hover: intensificar glow */
  .sv-right:hover .sv-img {
    filter:
      drop-shadow(0 0 36px rgba(255, 85, 0, 0.45))
      drop-shadow(0 0 70px rgba(255, 85, 0, 0.20))
      drop-shadow(0 24px 40px rgba(0, 0, 0, 0.20));
    transition: filter 0.4s ease;
  }

  /* Responsive */
  @media (max-width: 1023px) {
    .sv-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .sv-right {
      order: 2;
      padding: 2rem 1.5rem;
    }

    .sv-left {
      order: 1;
    }

    .sv-img {
      max-width: 260px;
    }

    .sv-item {
      border-radius: 10px;
      border-left-width: 0.5px;
    }

    .sv-item.active {
      border-left-width: 3px;
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('#sv-list .sv-item')

  function activar(el: HTMLElement) {
    items.forEach(i => {
      i.classList.remove('active')
      i.setAttribute('aria-expanded', 'false')
      i.style.borderLeftColor = 'transparent'
    })
    el.classList.add('active')
    el.setAttribute('aria-expanded', 'true')
    el.style.borderLeftColor = el.dataset.acento ?? '#FF5500'
  }

  items.forEach(item => {
    item.addEventListener('click', () => activar(item))
    item.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault()
        activar(item)
      }
    })
  })

  const primero = items[0]
  if (primero) {
    primero.classList.add('active')
    primero.setAttribute('aria-expanded', 'true')
    primero.style.borderLeftColor = primero.dataset.acento ?? '#FF5500'
  }
</script>
