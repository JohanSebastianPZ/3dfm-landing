---
const links = [
  { href: '#', label: 'Aviso legal' },
  { href: '#', label: 'Privacidad' },
  { href: '#', label: 'Cookies' },
]
---
<footer
  class="py-7 px-6 sm:px-12 md:px-20 lg:px-28 border-t"
  style="background: #E8E8E6; border-top-color: #DEDEDD"
>
  <div class="section-container">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-6 lg:gap-3 text-center lg:text-left">

      <a href="/" class="flex items-center justify-center gap-2" aria-label="PrintLab3D inicio">
        <img 
          src="/images/logo-navbar.webp" 
          alt="Logo de PrintLab3D" 
          class="w-5 h-5 object-contain"
          width="100"
          height="100"
        />
        <span class="text-[17px] font-medium" style="color: #111111">
          PrintLab<span style="color: #FF5500">3D</span>
        </span>
      </a>

      <p class="text-[15px]" style="color: #AAAAAA">
        © 2026 PrintLab3D · Todos los derechos reservados
      </p>

      <div class="flex flex-wrap justify-center gap-5">
        {links.map(l => (
          <a
            href={l.href}
            class="text-[15px] transition-colors duration-200 hover:text-gray-700"
            style="color: #9ca3af"
          >
            {l.label}
          </a>
        ))}
      </div>

    </div>
  </div>
</footer>