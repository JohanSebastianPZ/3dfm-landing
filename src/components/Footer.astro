---
const links = [
  { href: '/aviso-legal', label: 'Aviso legal' },
  { href: '/privacidad',  label: 'Privacidad'  },
  { href: '/cookies',     label: 'Cookies'     },
]
---
<footer
  class="py-7 px-6 sm:px-12 md:px-20 lg:px-28 border-t"
  style="background: #E8E8E6; border-top-color: #DEDEDD"
>
  <div class="section-container">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-6 lg:gap-3 text-center lg:text-left">

      <a href="/" class="flex items-center justify-center gap-2" aria-label="3DFM inicio">
        <img 
          src="/images/logo-navbar.webp" 
          alt="Logo de 3DFM" 
          class="w-5 h-5 object-contain"
          width="20"
          height="20"
        />
        <span class="text-[17px] font-medium" style="color: #111111">
          3D<span style="color: #FF5500"> Factory Maker</span>
        </span>
      </a>

      <p class="text-[15px]" style="color: #6b7280">
        © 2026 3DFM · Todos los derechos reservados
      </p>

      <div class="flex flex-wrap justify-center gap-5">
        {links.map(l => (
          <a
            href={l.href}
            class="text-[15px] transition-colors duration-200 hover:text-gray-700"
            style="color: #6b7280"
          >
            {l.label}
          </a>
        ))}
      </div>

    </div>
  </div>
</footer>