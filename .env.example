# ============================================
# VARIABLES DE ENTORNO - PRINTLAB 3D
# ============================================
# Copia este archivo y renómbralo a .env
# Rellena los valores según tu entorno
# NUNCA subas el .env real a GitHub
# ============================================


# --------------------------------------------
# WEB3FORMS - Envío de emails del formulario
# --------------------------------------------
# Access Key obtenida desde web3forms.com
# Se usa directamente en el frontend (variable pública)
# Regístrate en: https://web3forms.com
PUBLIC_WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx


# --------------------------------------------
# CONFIGURACIÓN DEL SITIO
# --------------------------------------------
# URL pública del sitio (sin barra al final)
# Desarrollo:  http://localhost:4321
# Producción:  https://printlab3d.com
PUBLIC_SITE_URL=https://printlab3d.com